node_modules/
.env
.env_*
# npm.pkg.github.com auth token for @melchi45/rtsp-over-websocket (2026-07-23,
# docs/ops/RTSP_Over_WebSocket_Streaming_Setup.md §2) — per-developer secret, never commit.
client/.npmrc

# npm.pkg.github.com auth token for @melchi45/wisenet-udp-discovery (2026-08-25,
# docs/design/Design_Camera_Discovery.md) — per-developer secret, never commit.
server/.npmrc

server/storage/
client/dist/
*.db
*.db-shm
*.db-wal

# Local lockfile (root) — not currently kept in sync across dev machines
/package-lock.json

# Local face tracking data (runtime-generated, machine-specific)
storage/face_tracking.json

# ML model binaries (too large for GitHub; use Git LFS or download script)
server/models/*.onnx
*.pt

# Auto-generated TLS certificates
auto.crt
auto.key

# Backup files
*.bak

# Runtime log files (production log output — written to /var/log/lts or server/logs/)
server/logs/
sdp-debug.log

# Python bytecode cache
ingest-daemon/__pycache__/
**/__pycache__/
*.pyc

# mediasoup-worker priority wrapper — machine/architecture-specific compiled
# binary + CMake scratch dir, rebuilt locally via `npm run build:mediasoup-wrapper`
# (server/src/scripts/buildMediasoupWorkerWrapper.js). Source (wrapper.c,
# CMakeLists.txt) is committed; build output is not.
tools/mediasoup-worker-priority-wrapper/build/
tools/mediasoup-worker-priority-wrapper/bin/

# client/public/ currently holds only @melchi45/rtsp-over-websocket's Web
# Worker WASM/JS sidecars, copied in at build time from node_modules by the
# `prebuild` script (client/scripts/copyRtspOverWebSocketAssets.js) —
# regenerated by `npm install`/`npm run build`, not source, do not commit.
# NOTE: this ignores the whole directory, not just today's 5 files, so any
# future build-copied asset here is covered automatically — but it also
# means a genuinely-committed static asset (favicon.ico, robots.txt, etc.)
# placed directly in client/public/ would be silently ignored too. If that
# ever happens, git add -f it explicitly rather than removing this rule.
client/public/
