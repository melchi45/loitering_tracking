# ump-player runtime assets — postinstall-generated symlinks into
# submodules/ump-player (client/scripts/copyUmpPlayerAssets.js, 2026-07-24).
# Never commit: symlink targets are relative to this checkout's layout and
# assume the submodule is initialized.
client/public/media/
client/public/ump-player/
server/storage/
client/dist/
*.db
*.db-shm
*.db-wal

# Local lockfile (root) — not currently kept in sync across dev machines
/package-lock.json

# Local face tracking data (runtime-generated, machine-specific)
storage/face_tracking.json

# ML model binaries (too large for GitHub; use Git LFS or download script)
server/models/*.onnx
*.pt

# Auto-generated TLS certificates
auto.crt
auto.key

# Backup files
