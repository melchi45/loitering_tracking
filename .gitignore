# Runtime log files (production log output — written to /var/log/lts or server/logs/)
server/logs/
sdp-debug.log

# Python bytecode cache
ingest-daemon/__pycache__/
**/__pycache__/
*.pyc

# mediasoup-worker priority wrapper — machine/architecture-specific compiled
